<div id="<%= plural_table_name %>" class="b4um-card-grid">
  <%% <%= plural_table_name %>.each do |<%= file_name %>| %>
    <article class="b4um-card">
      <%%= render <%= file_name %>, compact: true %>

      <div class="b4um-card__actions">
        <%%= link_to "Show",
                    <%= file_name %>,
                    class: "button button--secondary" %>
      </div>
    </article>
  <%% end %>
</div>
