# frozen_string_literal: true

class SessionsController < ApplicationController
  def new
  end

  def create
    <%= authentication_model_name %> = <%= authentication_class_name %>.find_by(email: params[:email])

    if <%= authentication_model_name %>&.authenticate(params[:password])
      session[:<%= authentication_model_name %>_id] = <%= authentication_model_name %>.id

      redirect_to root_path, notice: "Successfully logged in."
    else
      flash.now[:alert] = "Invalid email or password."
      render :new, status: :unprocessable_content
    end
  end

  def destroy
    session.delete(:<%= authentication_model_name %>_id)

    redirect_to root_path, notice: "Successfully logged out."
  end
end
