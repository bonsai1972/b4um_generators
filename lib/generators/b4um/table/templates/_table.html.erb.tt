<div class="b4um-table-wrapper">
  <table class="b4um-table">
    <thead>
      <tr>
<% table_attributes.each do |attribute| -%>
        <th><%= attribute.name.humanize %></th>
<% end -%>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody id="<%= plural_table_name %>">
      <%% <%= plural_table_name %>.each do |<%= file_name %>| %>
        <tr>
<% table_attributes.each do |attribute| -%>
          <td>
<% if attribute.name == "status" -%>
            <span class="b4um-badge">
              <%%= <%= file_name %>.<%= attribute.name %> %>
            </span>
<% elsif attribute.type == :text -%>
            <%%= truncate(<%= file_name %>.<%= attribute.name %>, length: 100) %>
<% else -%>
            <%%= <%= file_name %>.<%= attribute.name %> %>
<% end -%>
          </td>
<% end -%>

          <td>
            <div class="b4um-table__actions">
              <%%= link_to "Show",
                          <%= file_name %>,
                          class: "button button--secondary" %>
            </div>
          </td>
        </tr>
      <%% end %>
    </tbody>
  </table>
</div>
