# frozen_string_literal: true

require "io/console"

namespace :b4um do
  namespace :admin do
    desc "Create an administrator"

    task create: :environment do
      model = <%= authentication_class_name %>

      missing_columns = %w[admin blocked] - model.column_names

      unless missing_columns.empty?
        abort(
          "Missing database columns: #{missing_columns.join(', ')}. " \
          "Run bin/rails db:migrate before creating an administrator."
        )
      end

      required_fields = model.validators
                            .select do |validator|
                              next false unless validator.is_a?(
                                ActiveModel::Validations::PresenceValidator
                              )

                              validator.options[:if].nil? &&
                                (
                                  validator.options[:unless].nil? ||
                                  validator.options[:unless] == :guest?
                                )
                            end
                            .flat_map(&:attributes)
                            .map(&:to_s)

      attributes = {}

<% admin_creation_fields.each do |field| -%>
      required = required_fields.include?("<%= field %>")
      required_marker = required ? " *" : ""
      <%= field %> = nil

      loop do
        print "<%= admin_user_field_label(field) %>#{required_marker}: "
        <%= field %> = STDIN.gets&.strip

        break unless required && (<%= field %>.nil? || <%= field %>.empty?)

        puts "<%= admin_user_field_label(field) %> cannot be empty."
      end

      unless <%= field %>.nil? || <%= field %>.empty?
        attributes[:<%= field %>] = <%= field %>
      end

<% end -%>
      email = nil
      password = nil
      password_confirmation = nil

      loop do
        print "Email *: "
        email = STDIN.gets&.strip

        break unless email.nil? || email.empty?

        puts "Email cannot be empty."
      end

      if model.exists?(email: email)
        abort "A user with this email already exists."
      end

      loop do
        print "Password *: "
        password = STDIN.noecho(&:gets)&.strip
        puts

        break unless password.nil? || password.empty?

        puts "Password cannot be empty."
      end

      loop do
        print "Confirm password *: "
        password_confirmation = STDIN.noecho(&:gets)&.strip
        puts

        break if password == password_confirmation

        puts "Passwords do not match."
      end

      attributes.merge!(
        email: email,
        password: password,
        password_confirmation: password_confirmation,
        admin: true
      )

      model.create!(attributes)

      puts "Administrator #{email} was created successfully."
    end
  end
end
