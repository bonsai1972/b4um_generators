<%% content_for :title, "<%= plural_table_name.humanize %>" %>

<div class="page-header">
  <h1><%= plural_table_name.humanize %></h1>

  <%%= link_to "New <%= singular_table_name.humanize.downcase %>",
              new_<%= singular_route_name %>_path,
              class: "button button--primary" %>
</div>

<div id="<%= plural_table_name %>" class="b4um-grid">
  <%% @<%= plural_table_name %>.each_with_index do |<%= singular_table_name %>, index| %>
    <%% card_class =
      case index % 5
      when 0
        "b4um-card b4um-card--wide"
      when 1
        "b4um-card b4um-card--soft"
      when 3
        "b4um-card b4um-card--large"
      else
        "b4um-card"
      end
    %>

    <article class="<%%= card_class %>">
      <%%= render <%= singular_table_name %>, compact: true %>

      <div class="b4um-card__actions">
        <%%= link_to "Show",
                    <%= singular_table_name %>,
                    class: "button button--secondary" %>
      </div>
    </article>
  <%% end %>
</div>
