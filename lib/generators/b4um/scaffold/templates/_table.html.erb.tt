<div class="b4um-table-wrapper">
  <table class="b4um-table">
    <thead>
      <tr>
<% attributes.each do |attribute| -%>
        <th><%= attribute.name.humanize %></th>
<% end -%>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <%% <%= plural_table_name %>.each do |<%= singular_table_name %>| %>
        <tr>
<% attributes.each do |attribute| -%>
          <td>
<% if select_field?(attribute.name) -%>
<% if attribute.name == "status" -%>
            <span class="b4um-badge">
              <%%=
                <%= select_configuration[:values].inspect %>.to_h {
                  |choice| [choice[:value], choice[:label]]
                }.fetch(
                  <%= singular_table_name %>.<%= attribute.name %>,
                  <%= singular_table_name %>.<%= attribute.name %>
                )
              %>
            </span>
<% else -%>
            <%%=
              <%= select_configuration[:values].inspect %>.to_h {
                |choice| [choice[:value], choice[:label]]
              }.fetch(
                <%= singular_table_name %>.<%= attribute.name %>,
                <%= singular_table_name %>.<%= attribute.name %>
              )
            %>
<% end -%>
<% elsif radio_field?(attribute.name) -%>
            <%%=
              <%= radio_configuration[:values].inspect %>.to_h {
                |choice| [choice[:value], choice[:label]]
              }.fetch(
                <%= singular_table_name %>.<%= attribute.name %>,
                <%= singular_table_name %>.<%= attribute.name %>
              )
            %>
<% elsif attribute.name == "status" -%>
            <span class="b4um-badge">
              <%%= <%= singular_table_name %>.<%= attribute.name %> %>
            </span>
<% elsif attribute.type == :text -%>
            <%%= truncate(<%= singular_table_name %>.<%= attribute.name %>, length: 100) %>
<% elsif attribute.type == :decimal -%>
            <%%= number_with_precision(
                  <%= singular_table_name %>.<%= attribute.name %>,
                  precision: 2,
                  delimiter: ".",
                  separator: ","
                ) %>
<% else -%>
            <%%= <%= singular_table_name %>.<%= attribute.name %> %>
<% end -%>
          </td>
<% end -%>

          <td>
            <div class="b4um-table__actions">
              <%%= link_to "Show",
                          <%= singular_table_name %>,
                          class: "button button--secondary" %>
            </div>
          </td>
        </tr>
      <%% end %>
    </tbody>
  </table>
</div>
