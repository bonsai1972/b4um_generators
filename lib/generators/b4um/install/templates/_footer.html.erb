<footer class="b4um-footer">
  <a
    class="b4um-footer__back-to-top"
    href="#b4um-page-top"
    data-controller="scroll-to-top"
    data-action="click->scroll-to-top#scroll"
  >
    Zurück zum Seitenanfang
  </a>

  <div class="b4um-footer__inner">
    <p class="b4um-footer__copyright">
      &copy;
      <%= Time.current.year %>
      Deine Anwendung
    </p>

    <nav class="b4um-footer__links" aria-label="Rechtliche Hinweise">
      <%# B4UM_FOOTER_LINKS %>
    </nav>
  </div>
</footer>
